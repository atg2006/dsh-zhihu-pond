{
  "name": "dsh-zhihu-pond",
  "version": "0.1.0",
  "description": "只读信息流插件：把知乎（后续可加公众号、小红书）的公开内容读成文本交给 DSH。不评论、不点赞、不发布、不改动账号。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "feed",
    "zhihu",
    "read-only"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "smoke": "node tools/smoke.mjs"
  }
}
